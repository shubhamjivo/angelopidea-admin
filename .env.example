HOST=127.0.0.1
PORT=1337
# Public site URL. Required on the Windows server, and required again before `npm run build`.
PUBLIC_URL=https://admin.angelopedia.com
# Trust X-Forwarded-* from IIS. Leave false for local `strapi develop`.
IS_PROXIED=true
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Supabase session pooler (IPv4). Do not also set DATABASE_HOST; it overrides DATABASE_URL.
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
