{
  "kind": "collectionType",
  "collectionName": "videos",
  "info": {
    "singularName": "video",
    "pluralName": "videos",
    "displayName": "Video",
    "description": "A YouTube video filed under a pageant, an edition or a contestant."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "youtubeUrl": {
      "type": "string",
      "required": true
    },
    "exclusive": {
      "type": "boolean",
      "default": false
    },
    "event": {
      "type": "string"
    },
    "publishedOn": {
      "type": "date",
      "required": true
    },
    "startTime": {
      "type": "integer"
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "dislikes": {
      "type": "integer",
      "default": 0
    },
    "pageant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pageant.pageant"
    },
    "edition": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::edition.edition"
    },
    "contestant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::contestant.contestant"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "legacyId": {
      "type": "integer",
      "private": true
    }
  }
}
