{
  "kind": "collectionType",
  "collectionName": "editions",
  "info": {
    "singularName": "edition",
    "pluralName": "editions",
    "displayName": "Pgnt. Edition",
    "description": "One yearly staging of a pageant, such as Miss Earth 2021."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "alternateName": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "pageant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pageant.pageant",
      "inversedBy": "editions"
    },
    "year": {
      "type": "integer",
      "required": true
    },
    "editionNumber": {
      "type": "integer"
    },
    "finalDate": {
      "type": "date"
    },
    "venue": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "applicationOpens": {
      "type": "date"
    },
    "applicationDeadline": {
      "type": "date"
    },
    "schedule": {
      "type": "component",
      "component": "pageant.schedule-item",
      "repeatable": true
    },
    "intro": {
      "type": "text"
    },
    "about": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "entries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::edition-entry.edition-entry",
      "mappedBy": "edition"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "legacyId": {
      "type": "integer",
      "private": true
    }
  }
}
