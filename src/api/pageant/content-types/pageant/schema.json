{
  "kind": "collectionType",
  "collectionName": "pageants",
  "info": {
    "singularName": "pageant",
    "pluralName": "pageants",
    "displayName": "Pageant (pgnt.)",
    "description": "A pageant organisation, such as Miss Earth."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "alternateName": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "tier": {
      "type": "enumeration",
      "required": true,
      "default": "national",
      "enum": [
        "big4",
        "international",
        "regional",
        "national",
        "other"
      ]
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "motto": {
      "type": "string"
    },
    "foundedYear": {
      "type": "integer"
    },
    "headquarters": {
      "type": "string"
    },
    "organisation": {
      "type": "string"
    },
    "president": {
      "type": "string"
    },
    "keyPeople": {
      "type": "text"
    },
    "website": {
      "type": "string"
    },
    "facebook": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "about": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "editions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::edition.edition",
      "mappedBy": "pageant"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "legacyId": {
      "type": "integer",
      "private": true
    }
  }
}
