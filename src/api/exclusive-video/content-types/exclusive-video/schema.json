{
  "kind": "collectionType",
  "collectionName": "exclusive_videos",
  "info": {
    "singularName": "exclusive-video",
    "pluralName": "exclusive-videos",
    "displayName": "Angelopedia Exclusive",
    "description": "A video in the Angelopedia Exclusive section: an exclusive interview, another interview or a final video."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "group": {
      "type": "enumeration",
      "enum": ["exclusiveInterview", "otherInterview", "finalVideo"],
      "required": true,
      "default": "exclusiveInterview"
    },
    "kicker": {
      "type": "string"
    },
    "dateLabel": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "videoFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "link": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer"
    }
  }
}
